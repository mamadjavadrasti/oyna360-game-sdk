{
  "name": "@oyna360/game-sdk",
  "version": "0.5.1",
  "description": "oyna360 Game SDK — postMessage bridge + Direct Development Mode (init, scores, achievements, gem→coin).",
  "license": "MIT",
  "author": "oyna360",
  "keywords": [
    "oyna360",
    "game-sdk",
    "iframe",
    "postmessage",
    "leaderboard",
    "achievements"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No lint configured for @oyna360/game-sdk\""
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mamadjavadrasti/oyna360-game-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mamadjavadrasti/oyna360-game-sdk/issues"
  },
  "homepage": "https://github.com/mamadjavadrasti/oyna360-game-sdk#readme",
  "publishConfig": {
    "access": "public"
  }
}
